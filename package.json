{
  "name": "vocal-combat-multiplayer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NGROK=true concurrently \"npm run server\" \"npm run client\" \"npm run ngrok\"",
    "dev:local": "concurrently \"npm run server\" \"npm run client\"",
    "dev:lan": "cross-env LAN_HTTPS=true concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx server/index.ts",
    "ngrok": "node start-ngrok.js",
    "build": "vite build",
    "preview": "vite preview",
    "song:auto": "tsx scripts/auto-song-pack.ts",
    "song:manual": "node scripts/add-song.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "express": "^4.21.0",
    "lucide-react": "^0.563.0",
    "midi-parser-js": "^4.0.4",
    "ngrok": "^5.0.0-beta.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ytmusic-api": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
